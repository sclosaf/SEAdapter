#    to add to the script further below:
#   
#    % cd /java/re/jdk/1.4.2/latest/doc
#    % ls -f 
#      api/       build/     guide/     tooldocs/
#    % ls -f guide/2d guide/jpda guide/plugin guide/security
#      guide/2d:
