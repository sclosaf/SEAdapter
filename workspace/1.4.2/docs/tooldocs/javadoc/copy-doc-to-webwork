#    
#      guide/plugin:
#      dom/
#    
#      guide/security:
#      jaas/  jgss/

#SRCDIR=/java/re/jdk/1.4.2/latest/doc
SRCDIR=/java/pubs/ws/mantis-docs-GA/build/solaris-sparc/doc
OUTDIR=/usr/web/work/j2se/1.4.2/docs
SCCSCREATEALL=/java/pubs/bin/sccscreate-recursive

echo "MUST BE LOGGED IN TO webwork.sfbay"

mkdir -p     $OUTDIR/tooldocs/javadoc
